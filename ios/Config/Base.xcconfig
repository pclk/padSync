// Shared build settings. Per-machine values (your signing team) go in Local.xcconfig,
// which is not committed; copy Local.xcconfig.example to start.

// The deployment the app talks to. HTTPS only.
PADSYNC_HOST = p.siew.dev

// A free Apple ID can't register an id someone else already has, so keep this unique.
PADSYNC_BUNDLE_ID = com.weiheng.padsync

// Shared by the app, its widget and its Share extension.
PADSYNC_APP_GROUP = group.$(PADSYNC_BUNDLE_ID)

#include? "Local.xcconfig"
